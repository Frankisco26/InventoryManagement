@{
    ViewData["Title"] = "Usuarios";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.10/css/bootstrap-select.min.css" integrity="sha512-ajw1M6VIjDmbqggNaTSzQF3mS79dsPG/m0uO1gAoHHjrdaoPMyHWoI5e1bf7B+vbP+uoNK5xpo6SiJlTAMseGg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .datepicker {
            z-index: 10010 !important;
        }

        #fechaBloqueo {
            z-index: 99999 !important;
        }

        .control-label {
            font-size: 0.75em !important;
        }

        .form-control-sm {
            height: 2rem !important;
        }
    </style>
}

<section>
    <div class="portlet light">
        <div class="portlet-title">
            <div class="actions">
                <div class="btn-group btn-group-devided">
                    <a id="btnCrear" name="btnCrear" onclick="Crear();" class="botonAnimado btn btn-sm btn-success text-white" href="#" title="Nuevo">
                        <div class="svg-wrapper-1">
                            <div class="svg-wrapper">
                                <img width='25' src='/images/menu/nuevo.png' />
                            </div>
                        </div>
                        <span>Nuevo</span>
                    </a>
                    <a class="botonAnimado btn btn-sm btn-success text-white tool-action" data-action="0" href="#">
                        <div class="svg-wrapper-1">
                            <div class="svg-wrapper">
                                <img width='25' src='/images/menu/excel.png' />
                            </div>
                        </div>
                        <span>Excel</span>
                    </a>
                </div>
            </div>
            <div class="actions btn-group">
                <b><i class="fas fa-users mr-2"></i>@($"{ViewData["Title"]}")</b>
            </div>
        </div>
        <div class="portlet-body">
            <div class="tableFixHead">
                <table id="tb-usuarios" class="table table-striped table-bordered display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Empresa</th>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th data-orderable="false" data-priority="1" class="no-export"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <form id="formularioModal" method="post" asp-action="CrearActualizar">
        <input type="hidden" name="Id" id="Id" value="0" />
        <div id="modalUsuario" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content" id="modalContent">
                    <div class="modal-header modal-header-lg shape-lg">
                        <img class="logoHeader-lg" src="~/images/LetraContagestor.png" />
                        <h5 class="modal-title" style="position:relative; left:12rem;"><img class="logoHeader-lg" width="40" src="~/images/modals/usuario.png" /> Usuarios</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="modalContainer" class="container">
                            <div class="row">
                                <div class="form-group col-sm-12 col-lg-4">
                                    <label class="control-label">Nombre</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="Nombre" name="Nombre" type="text" class="form-control form-control-sm" required />
                                </div>

                                <div class="form-group col-sm-12 col-lg-4">
                                    <label class="control-label">Usuario</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="Cuenta" name="Cuenta" class="form-control form-control-sm" required autocomplete="off" />
                                </div>

                                <div class="form-group col-sm-12 col-lg-4">
                                    <label class="control-label">Correo electrónico</label>
                                    <input id="Email" name="Email" type="email" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-12 col-lg-4">
                                    <label class="control-label" id="labelClave">Contraseña</label>
                                    <input id="Clave" name="Clave" type="password" class="form-control form-control-sm" autocomplete="new-password" />
                                    <small class="form-text text-muted" id="ayudaClave">Si la deja vacía se generará una.</small>
                                </div>
                                <div class="form-group col-sm-12 col-lg-8">
                                    <label class="control-label">Empresa - Rol</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <select class="form-control form-control-sm selectpicker" data-live-search="true" multiple id="Roles" name="Roles" asp-items="@(new SelectList(ViewBag.Roles, "Value", "Name"))" required>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-sm btn-danger" data-dismiss="modal" href="#"><img width='25' class="mr-2" src='/images/menu/cancelar.png' />Cancelar</a>
                        <button type="submit" class="btn btn-sm btn-success"><img width='25' class="mr-2" src='/images/menu/salvar.png' />Almacenar</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @*Modal bloquear*@
    <div id="modalBloquear" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content" id="modalContentBloquear">
                <div class="modal-header modal-header-lg shape-lg">
                    <img class="logoHeader-lg" src="~/images/LetraContagestor.png" />
                    <h5 class="modal-title"><i class="fas fa-user"></i> Bloquear</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <input type="hidden" id="idUsuario" />
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label">Bloquear hasta</label>
                                <div class="input-group input-group-sm">
                                    <input id="fechaBloqueo" type="text" class="form-control form-control-sm datepicker" data-provide="datepicker" data-date-format="dd/mm/yyyy" data-date-language="es" data-date-autoclose="true">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-rango" type="button" id="btnFechaBloqueo"><i class="fas fa-calendar-alt"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-12">
                                <div class="icheck-primary icheck-inline">
                                    <input id="BloqueoIndefinido" type="checkbox" />
                                    <label style="font-size:0.8rem !important;" for="BloqueoIndefinido">Bloquear indefinidamente</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" onclick="Bloquear();" class="btn btn-sm btn-success"><img width='25' class="mr-2" src='/images/menu/salvar.png' />Bloquear</button>
                    <a class="btn btn-sm btn-danger" data-dismiss="modal" href="#"><img width='25' class="mr-2" src='/images/menu/cancelar.png' />Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.10/js/bootstrap-select.min.js"
            integrity="sha256-FXzZGmaRFZngOjUKy3lWZJq/MflaMpffBbu3lPT0izE="
            crossorigin="anonymous">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.10/js/i18n/defaults-es_ES.min.js" integrity="sha512-vFrnIg0aGzFQwRFVp3w9d3TMXShw/27FmqpUhCYhooiSWdtLZqpma4AB5MO2vJoTcK0lPMT8PuN+AQs0o+5iqg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        let tableMain = null;
        let nombreDescarga = "Usuarios";
        const usuarioActual = @(User.GetUserId<int>());

        function convertirFecha(fecha) {
            if (!fecha)
                return null;
            var dt = new Date(fecha);
            return isNaN(dt.getTime()) ? null : dt;
        }

        function estaBloqueado(row) {
            if (row.bloqueoHabilitado !== true)
                return false;
            var lockout = convertirFecha(row.fechaFin);
            return !lockout || lockout > new Date();
        }

        function token() {
            return $("#formularioModal input[name=__RequestVerificationToken]").val();
        }

        let config = {
            id: "tb-usuarios",
            ajax: {
                url: '@Url.Action("Listado", "Usuarios")',
                method: 'POST',
                dataType: "json",
                contentType: "application/json",
                data: function (d) {
                    return JSON.stringify(d);
                },
                dataSrc: function (e) {
                    return e;
                },
            },
            dom: "ftipr",
            buttons: [
                { extend: "excel", footer: false, filename: function () { return nombreDescarga; }, exportOptions: { columns: ':not(.no-export)' } }
            ],
            columns: [
                { width: '30%', data: "nombreEmpresa" },
                { width: '22%', data: "nombre" },
                { width: '15%', data: "cuenta" },
                { width: '15%', data: "email" },
                {
                    width: '8%',
                    data: null,
                    render: function (data, type, row, meta) {
                        if (estaBloqueado(row))
                            return `<span class="badge badge-danger">Bloqueado</span>`;

                        return `<span class="badge badge-success">Habilitado</span>`;
                    }
                },
                {
                    width: '5%', filter: 'none', type: 'none', data: null, orderable: false, className: "text-center", render: function (data, type, row, meta) {
                        var defaultMainActions =
                            "<span data-toggle='dropdown'>" +
                            "<a class='btn btn-sm btn-sm-td btn-block btn-primary dropdown-toggle' style='color: white !important;' aria-haspopup='true' aria-expanded='false' >" +
                            "<img width='20' src='/images/menu/menu.png' />" +
                            "</a>" +
                            "</span><div class='dropdown-menu'>";

                        if (estaBloqueado(row))
                            defaultMainActions += '<a class="dropdown-item" href="javascript:;" onclick="Activar(' + row["id"] + ')">Habilitar</a>';
                        else if (row["id"] !== usuarioActual)
                            defaultMainActions += '<a class="dropdown-item text-danger" href="javascript:;" onclick="MostrarModalBloqueo(' + row["id"] + ')">Bloquear</a>';

                        defaultMainActions += '<a class="dropdown-item" href="javascript:;" onclick="Editar(' + row["id"] + ')">Editar</a>';
                        defaultMainActions += '<a class="dropdown-item" href="javascript:;" onclick="RestablecerClave(' + row["id"] + ')">Restablecer contraseña</a>';
                        defaultMainActions += '</div>';
                        return defaultMainActions;
                    }
                }
            ],
            serverSide: false,
            processing: false,
            columnFilter: true,
            orderCellsTop: true,
            fixedHeader: true,
            initComplete: function (e) {
                $('#tb-usuarios').wrap("<div class='scrolledTable'></div>");
            },
            pageLength: 25
        };

        $(document).ready(function () {
            tableMain = configDatatable(config);

            $("#formularioModal").submit(function (e) {
                e.preventDefault();
                swal({
                    title: "¿Está seguro de guardar el usuario?",
                    text: "El usuario puede ser editado cuando desee",
                    icon: "/images/menu/question.png",
                    buttons: {
                        cancel: "Cancelar",
                        confirm: {
                            text: "Confirmar"
                        }
                    }
                }).then((isConfirm) => {
                    if (isConfirm === true) {
                        $.ajax({
                            url: $("#formularioModal").attr("action"),
                            data: $("#formularioModal").serialize(),
                            dataType: 'json',
                            type: 'POST',
                            beforeSend: function (data) {
                                showLoader();
                            },
                            success: function (data) {
                                hideLoader();
                                if (data.tipo === "s") {
                                    swal("¡Bien!", data.msg, "/images/menu/success.png").then((value) => {
                                        $("#modalUsuario").modal('hide');
                                        tableMain.ajax.reload();
                                    });
                                } else {
                                    swal("¡Advertencia!", data.msg, "/images/menu/error.png");
                                }
                            },
                            error: function () {
                                hideLoader();
                            }
                        });
                    }
                });
            });

            $("#btnFechaBloqueo").on("click", function () {
                $("#fechaBloqueo").datepicker("show");
            });
            $("#BloqueoIndefinido").on("click", function () {
                if ($('#BloqueoIndefinido').is(':checked')) {
                    $("#fechaBloqueo").attr("readonly", "readonly");
                    $("#btnFechaBloqueo").attr("disabled", "disabled");
                }
                else {
                    $("#fechaBloqueo").removeAttr("readonly");
                    $("#btnFechaBloqueo").removeAttr("disabled");
                }
            });

            hideLoader();
        });

        function Crear() {
            $('#formularioModal')[0].reset();
            $('#Roles').selectpicker('val', []);
            $('#Id').val(0);
            $("#labelClave").text("Contraseña");
            $("#ayudaClave").text("Si la deja vacía se generará una.");
            $('#modalUsuario').modal();
        }

        function Editar(id) {
            $.post("@Url.Action("ObtenerUsuario")?id=" + id).done(function (datos) {
                if (datos.tipo !== "e") {
                    var data = datos.usuario;
                    $('#formularioModal')[0].reset();
                    $("#Id").val(data.id);
                    $("#Nombre").val(data.nombre);
                    $("#Cuenta").val(data.cuenta);
                    $("#Email").val(data.email);
                    $("#Clave").val("");
                    $("#labelClave").text("Nueva contraseña");
                    $("#ayudaClave").text("Déjela vacía para mantener la actual.");
                    $('#Roles').selectpicker('val', data.roles);
                    $('#modalUsuario').modal();
                }
                else
                    swal("¡Advertencia!", datos.msg, "/images/menu/error.png");
            });
        }

        function Activar(id) {
            swal({
                title: "¿Está seguro de activar el usuario?",
                text: "El usuario puede ser bloqueado cuando desee",
                icon: "/images/menu/question.png",
                buttons: {
                    cancel: "Cancelar",
                    confirm: {
                        text: "Confirmar"
                    }
                }
            }).then((isConfirm) => {
                if (isConfirm)
                    $.ajax({
                        url: "@Url.Action("ActivarUsuario")",
                        type: "POST",
                        data: { id: id },
                        headers: { 'RequestVerificationToken': token() }
                    }).done(function (data) {
                        if (data.tipo !== "e")
                            swal("¡Bien!", data.msg, "/images/menu/success.png").then(() => tableMain.ajax.reload());
                        else
                            swal("¡Advertencia!", data.msg, "/images/menu/error.png");
                    });
            });
        }

        function RestablecerClave(id) {
            swal({
                title: "¿Está seguro de restablecer la contraseña?",
                text: "Se generará una contraseña nueva y la contraseña anterior dejará de funcionar.",
                icon: "/images/menu/question.png",
                buttons: {
                    cancel: "Cancelar",
                    confirm: {
                        text: "Confirmar"
                    }
                }
            }).then((isConfirm) => {
                if (isConfirm) {
                    showLoader();
                    $.ajax({
                        url: "@Url.Action("RestablecerClave")",
                        type: "POST",
                        data: { id: id },
                        headers: { 'RequestVerificationToken': token() }
                    }).done(function (data) {
                        if (data.tipo !== "e")
                            swal("¡Bien!", data.msg, "/images/menu/success.png");
                        else
                            swal("¡Advertencia!", data.msg, "/images/menu/error.png");
                    }).fail(function () {
                        swal("¡Advertencia!", "No se pudo restablecer la contraseña.", "/images/menu/error.png");
                    }).always(function () {
                        hideLoader();
                    });
                }
            });
        }

        function MostrarModalBloqueo(id) {
            $("#idUsuario").val(id);
            $("#fechaBloqueo").val("");
            $("#BloqueoIndefinido").prop("checked", false);
            $("#fechaBloqueo").removeAttr("readonly");
            $("#btnFechaBloqueo").removeAttr("disabled");
            $("#modalBloquear").modal("show");
        }

        function Bloquear() {
            var fecha = null;
            if ($('#BloqueoIndefinido').is(':checked'))
                fecha = new Date(2999, 0, 1);
            else
                fecha = $("#fechaBloqueo").datepicker('getDate');

            if (!fecha) {
                swal("¡Advertencia!", "Seleccione la fecha de fin del bloqueo.", "/images/menu/error.png");
                return;
            }

            swal({
                title: "¿Está seguro de bloquear el usuario?",
                text: "El usuario puede ser desbloqueado cuando desee",
                icon: "/images/menu/question.png",
                buttons: {
                    cancel: "Cancelar",
                    confirm: {
                        text: "Confirmar"
                    }
                }
            }).then((isConfirm) => {
                if (isConfirm) {
                    var id = $("#idUsuario").val();
                    var fechaIso = fecha.getFullYear() + "-" + ('0' + (fecha.getMonth() + 1)).slice(-2) + "-" + ('0' + fecha.getDate()).slice(-2);
                    $.ajax({
                        url: "@Url.Action("BloquearUsuario")",
                        type: "POST",
                        data: { id: id, fecha: fechaIso },
                        headers: { 'RequestVerificationToken': token() }
                    }).done(function (data) {
                        if (data.tipo !== "e") {
                            $("#modalBloquear").modal("hide");
                            swal("¡Listo!", data.msg, "/images/menu/success.png").then(() => tableMain.ajax.reload());
                        }
                        else
                            swal("¡Advertencia!", data.msg, "/images/menu/error.png");
                    });
                }
            });
        }
    </script>
}
