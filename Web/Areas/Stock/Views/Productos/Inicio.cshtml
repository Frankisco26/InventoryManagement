@model InventoryManagement.Web.Models.Session.EmpresaViewModel
@{
    ViewData["Title"] = "Productos";
    var puedeMovimientos = Model.Pantallas.Any(p => p.Area == "Stock" && p.Controlador == "Movimientos");
}

@section Styles {
    <style>
        .control-label {
            font-size: 0.75em !important;
        }

        .form-control-sm {
            height: 2rem !important;
        }
    </style>
}

<section>
    <div class="portlet light">
        <div class="portlet-title">
            <div class="actions">
                <div class="btn-group btn-group-devided">
                    @if (Model.PermiteCrear)
                    {
                        <a id="btnCrear" onclick="Crear();" class="botonAnimado btn btn-sm btn-success text-white" href="#" title="Nuevo">
                            <div class="svg-wrapper-1">
                                <div class="svg-wrapper">
                                    <img width='25' src='/images/menu/nuevo.png' />
                                </div>
                            </div>
                            <span>Nuevo</span>
                        </a>
                    }
                    <a class="botonAnimado btn btn-sm btn-success text-white tool-action" data-action="0" href="#">
                        <div class="svg-wrapper-1">
                            <div class="svg-wrapper">
                                <img width='25' src='/images/menu/excel.png' />
                            </div>
                        </div>
                        <span>Excel</span>
                    </a>
                </div>
            </div>
            <div class="actions btn-group">
                <b><i class="fas fa-box mr-2"></i>@($"{ViewData["Title"]}")</b>
            </div>
        </div>
        <div class="portlet-body">
            <div class="tableFixHead">
                <table id="tb-productos" class="table table-striped table-bordered display" style="width:100%">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Stock mínimo</th>
                            <th>Precio</th>
                            <th data-orderable="false" data-priority="1" class="no-export"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <form id="formularioModal" method="post" asp-action="CrearActualizar">
        <input type="hidden" name="id" id="Id" value="0" />
        <div id="modalProducto" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header modal-header-lg shape-lg">
                        <img class="logoHeader-lg" src="~/images/LetraContagestor.png" />
                        <h5 class="modal-title" style="position:relative; left:12rem;"><img class="logoHeader-lg" width="40" src="~/images/modals/producto.png" /> <span id="tituloModal">Producto</span></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="container">
                            <div class="row">
                                <div class="form-group col-sm-12 col-lg-8">
                                    <label class="control-label">Nombre del producto</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="Name" name="Name" class="form-control form-control-sm campo" required minlength="2" maxlength="200" placeholder="Ingresa el nombre" />
                                </div>
                                <div class="form-group col-sm-12 col-lg-4">
                                    <label class="control-label">SKU (Código único)</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="SKU" name="SKU" class="form-control form-control-sm" required maxlength="50" placeholder="Ej: PROD-001" />
                                    <small class="form-text text-muted" id="ayudaSku">Debe ser único en la empresa</small>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-12 col-lg-6">
                                    <label class="control-label">Categoría</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="Category" name="Category" class="form-control form-control-sm campo" required minlength="2" maxlength="100" placeholder="Ej: Electrónica" />
                                </div>
                                <div class="form-group col-sm-12 col-lg-6">
                                    <label class="control-label">Precio unitario</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="UnitPrice" name="UnitPrice" type="number" step="0.01" min="0.01" class="form-control form-control-sm campo" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-12 col-lg-6" id="grupoCantidad">
                                    <label class="control-label">Cantidad inicial</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="QuantityInStock" name="QuantityInStock" type="number" step="1" min="0" class="form-control form-control-sm" value="0" required />
                                </div>
                                <div class="form-group col-sm-12 col-lg-6">
                                    <label class="control-label">Cantidad mínima</label>
                                    <label class="text-danger" style="font-size:0.875rem">*</label>
                                    <input id="MinimumStock" name="MinimumStock" type="number" step="1" min="0" class="form-control form-control-sm campo" value="0" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-sm btn-danger" data-dismiss="modal" href="#"><img width='25' class="mr-2" src='/images/menu/cancelar.png' />Cancelar</a>
                        <button type="submit" id="btnAlmacenar" class="btn btn-sm btn-success"><img width='25' class="mr-2" src='/images/menu/salvar.png' />Almacenar</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        let tableMain = null;
        let nombreDescarga = "Productos";
        const permiteEditar = @(Model.PermiteEditar ? "true" : "false");
        const permiteAnular = @(Model.PermiteAnular ? "true" : "false");
        const puedeMovimientos = @(puedeMovimientos ? "true" : "false");

        function token() {
            return $("#formularioModal input[name=__RequestVerificationToken]").val();
        }

        let config = {
            id: "tb-productos",
            ajax: {
                url: '@Url.Action("Listado", "Productos")',
                method: 'POST',
                dataType: "json",
                contentType: "application/json",
                data: function (d) {
                    return JSON.stringify(d);
                },
                dataSrc: function (e) {
                    return e;
                },
            },
            dom: "ftipr",
            buttons: [
                { extend: "excel", footer: false, filename: function () { return nombreDescarga; }, exportOptions: { columns: ':not(.no-export)' } }
            ],
            columns: [
                { width: '12%', data: "sku", render: function (data) { return `<b>${data}</b>`; } },
                { width: '30%', data: "name" },
                { width: '18%', data: "category", filter: "select" },
                { width: '10%', className: "text-right", data: "quantityInStock" },
                { width: '10%', className: "text-right", data: "minimumStock" },
                { width: '10%', className: "text-right", data: "unitPrice", render: function (data) { return "$" + parseNumStr(data, 2); } },
                {
                    width: '5%', filter: 'none', type: 'none', data: null, orderable: false, className: "text-center", render: function (data, type, row, meta) {
                        var acciones =
                            "<span data-toggle='dropdown'>" +
                            "<a class='btn btn-sm btn-sm-td btn-block btn-primary dropdown-toggle' style='color: white !important;' aria-haspopup='true' aria-expanded='false' >" +
                            "<img width='20' src='/images/menu/menu.png' />" +
                            "</a>" +
                            "</span><div class='dropdown-menu'>";

                        acciones += '<a class="dropdown-item" href="javascript:;" onclick="Ver(' + row["id"] + ')">Ver</a>';
                        if (permiteEditar)
                            acciones += '<a class="dropdown-item" href="javascript:;" onclick="Editar(' + row["id"] + ')">Editar</a>';
                        if (puedeMovimientos)
                            acciones += `<a class="dropdown-item" href="@Url.Action("Inicio", "Movimientos")?productoId=${row["id"]}">Movimientos</a>`;
                        if (permiteAnular)
                            acciones += '<a class="dropdown-item text-danger" href="javascript:;" onclick="Eliminar(' + row["id"] + ')">Eliminar</a>';
                        acciones += '</div>';
                        return acciones;
                    }
                }
            ],
            createdRow: function (row, data) {
                if (data.quantityInStock <= data.minimumStock)
                    $(row).addClass("table-danger");
            },
            serverSide: false,
            processing: false,
            columnFilter: true,
            orderCellsTop: true,
            fixedHeader: true,
            initComplete: function (e) {
                $('#tb-productos').wrap("<div class='scrolledTable'></div>");
            },
            pageLength: 25
        };

        $(document).ready(function () {
            tableMain = configDatatable(config);

            $("#formularioModal").submit(function (e) {
                e.preventDefault();
                swal({
                    title: "¿Está seguro de guardar el producto?",
                    text: "",
                    icon: "/images/menu/question.png",
                    buttons: {
                        cancel: "Cancelar",
                        confirm: {
                            text: "Confirmar"
                        }
                    }
                }).then((isConfirm) => {
                    if (isConfirm === true) {
                        $.ajax({
                            url: $("#formularioModal").attr("action"),
                            data: $("#formularioModal").serialize(),
                            dataType: 'json',
                            type: 'POST',
                            beforeSend: function () {
                                showLoader();
                            },
                            success: function (data) {
                                hideLoader();
                                if (data.tipo === "s") {
                                    swal("¡Bien!", data.mensaje, "/images/menu/success.png").then(() => {
                                        $("#modalProducto").modal('hide');
                                        tableMain.ajax.reload();
                                    });
                                } else {
                                    swal("¡Advertencia!", data.mensaje, "/images/menu/error.png");
                                }
                            },
                            error: function () {
                                hideLoader();
                                swal("¡Advertencia!", "No se pudo guardar el producto.", "/images/menu/error.png");
                            }
                        });
                    }
                });
            });

            hideLoader();
        });

        function prepararModal(modo) {
            var soloLectura = modo === "ver";
            $("#formularioModal input.campo").prop("readonly", soloLectura);
            $("#SKU").prop("readonly", modo !== "nuevo");
            $("#grupoCantidad").toggle(modo === "nuevo");
            $("#QuantityInStock").prop("disabled", modo !== "nuevo");
            $("#btnAlmacenar").toggle(!soloLectura);
            $("#ayudaSku").text(modo === "nuevo" ? "Debe ser único en la empresa" : "No se puede cambiar en edición");
            $("#tituloModal").text(modo === "nuevo" ? "Nuevo producto" : (modo === "editar" ? "Editar producto" : "Visualizar producto"));
        }

        function Crear() {
            $('#formularioModal')[0].reset();
            $("#Id").val(0);
            prepararModal("nuevo");
            $('#modalProducto').modal();
        }

        function cargarProducto(id, modo) {
            $.post("@Url.Action("Obtener", "Productos")", { id: id }).done(function (data) {
                if (data.tipo !== "s") {
                    swal("¡Advertencia!", data.mensaje, "/images/menu/error.png");
                    return;
                }
                var p = data.producto;
                $('#formularioModal')[0].reset();
                $("#Id").val(p.id);
                $("#Name").val(p.name);
                $("#SKU").val(p.sku);
                $("#Category").val(p.category);
                $("#UnitPrice").val(p.unitPrice);
                $("#QuantityInStock").val(p.quantityInStock);
                $("#MinimumStock").val(p.minimumStock);
                prepararModal(modo);
                $('#modalProducto').modal();
            });
        }

        function Ver(id) {
            cargarProducto(id, "ver");
        }

        function Editar(id) {
            cargarProducto(id, "editar");
        }

        function Eliminar(id) {
            swal({
                title: "¿Desea eliminar este producto?",
                text: "Se eliminarán también sus movimientos. Esta acción no se puede deshacer",
                icon: "/images/menu/question.png",
                buttons: {
                    cancel: "Cancelar",
                    confirm: "Continuar"
                },
            }).then((action) => {
                if (action === true) {
                    $.ajax({
                        url: '@Url.Action("Eliminar", "Productos")',
                        data: { id: id },
                        headers: { 'RequestVerificationToken': token() },
                        type: 'POST',
                        success: function (data) {
                            if (data.tipo === "s") {
                                swal("¡Hecho!", data.mensaje, "/images/menu/success.png");
                                tableMain.ajax.reload();
                            }
                            else
                                swal("¡Advertencia!", data.mensaje, "/images/menu/error.png");
                        }
                    });
                }
            });
        }
    </script>
}
