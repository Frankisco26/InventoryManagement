@model InventoryManagement.Web.Models.Session.EmpresaViewModel
@{
    ViewData["Title"] = "Movimientos de stock";
}

@section Styles {
    <style>
        .control-label {
            font-size: 0.75em !important;
        }
    </style>
}

<section>
    <div class="portlet light">
        <div class="portlet-title">
            <div class="actions">
                <div class="btn-group btn-group-devided">
                    <a href="@Url.Action("Inicio", "Productos")" class="botonAnimado btn btn-sm btn-danger text-white">
                        <div class="svg-wrapper-1">
                            <div class="svg-wrapper">
                                <img width='25' src='/images/menu/atras.png' />
                            </div>
                        </div>
                        <span>Productos</span>
                    </a>
                </div>
            </div>
            <div class="actions btn-group">
                <b><i class="fas fa-right-left mr-2"></i>@($"{ViewData["Title"]}")</b>
            </div>
        </div>
        <div class="portlet-body">
            <div class="row">
                <div class="form-group col-sm-12 col-lg-6">
                    <label class="control-label">Producto</label>
                    <select id="selectProducto" class="form-control form-control-sm" asp-items="@ViewBag.Productos">
                        <option value="">Seleccione un producto...</option>
                    </select>
                </div>
            </div>

            <div class="row" id="contenedorProducto" style="display:none;">
                <div class="col-lg-5">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0 font-weight-bold" id="nombreProducto"></h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6">
                                    <p class="mb-1"><b>SKU:</b> <code id="skuProducto"></code></p>
                                    <p class="mb-1"><b>Categoría:</b> <span id="categoriaProducto"></span></p>
                                </div>
                                <div class="col-6">
                                    <p class="mb-1"><span class="badge badge-info" id="stockProducto"></span></p>
                                    <p class="mb-1"><b>Precio:</b> $<span id="precioProducto"></span></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.PermiteCrear)
                    {
                        <div class="card">
                            <div class="card-header bg-secondary text-white">
                                <h6 class="mb-0">Registrar nuevo movimiento</h6>
                            </div>
                            <div class="card-body">
                                <form id="formMovimiento" method="post" asp-action="Registrar">
                                    <input type="hidden" name="productoId" id="productoId" />
                                    <div class="form-group">
                                        <label class="control-label">Tipo de movimiento</label>
                                        <select name="Type" id="Type" class="form-control form-control-sm">
                                            <option value="Inbound">Entrada</option>
                                            <option value="Outbound">Salida</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Cantidad</label>
                                        <label class="text-danger" style="font-size:0.875rem">*</label>
                                        <input name="Quantity" id="Quantity" type="number" min="1" step="1" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Razón / descripción</label>
                                        <label class="text-danger" style="font-size:0.875rem">*</label>
                                        <textarea name="Reason" id="Reason" rows="3" class="form-control form-control-sm" style="height:auto !important;" required minlength="2" maxlength="500" placeholder="Ej: Reabastecimiento, Venta, Devolución..."></textarea>
                                    </div>
                                    <div class="text-right">
                                        <button type="submit" class="btn btn-sm btn-success"><img width='25' class="mr-2" src='/images/menu/salvar.png' />Registrar movimiento</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-lg-7">
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <h6 class="card-title font-weight-bold">Historial de movimientos</h6>
                            <table id="tb-movimientos" class="table table-striped table-bordered display" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Cantidad</th>
                                        <th>Fecha</th>
                                        <th>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let tableMovimientos = null;

        function token() {
            return $("input[name=__RequestVerificationToken]").first().val();
        }

        function cargarProducto(id) {
            if (!id) {
                $("#contenedorProducto").hide();
                return;
            }
            $.post("@Url.Action("Producto", "Movimientos")", { id: id }).done(function (data) {
                if (data.tipo !== "s") {
                    swal("¡Advertencia!", data.mensaje, "/images/menu/error.png");
                    return;
                }
                var p = data.producto;
                $("#productoId").val(p.id);
                $("#nombreProducto").text(p.name);
                $("#skuProducto").text(p.sku);
                $("#categoriaProducto").text(p.category);
                $("#stockProducto").text(p.quantityInStock + " unidades");
                $("#stockProducto").toggleClass("badge-danger", p.quantityInStock <= p.minimumStock).toggleClass("badge-info", p.quantityInStock > p.minimumStock);
                $("#precioProducto").text(parseNumStr(p.unitPrice, 2));

                if (tableMovimientos) {
                    tableMovimientos.clear().rows.add(data.movimientos).draw();
                } else {
                    tableMovimientos = configDatatable({
                        id: "tb-movimientos",
                        data: data.movimientos,
                        dom: "tipr",
                        order: [[2, "desc"]],
                        columns: [
                            {
                                width: '15%', data: "type", render: function (data) {
                                    return data === "Inbound"
                                        ? '<span class="badge badge-success">ENTRADA</span>'
                                        : '<span class="badge badge-danger">SALIDA</span>';
                                }
                            },
                            { width: '12%', className: "text-right", data: "quantity" },
                            {
                                width: '23%', data: "timestamp", render: function (data, type) {
                                    if (type !== "display") return data;
                                    return formatDate(new Date(data), true);
                                }
                            },
                            { width: '50%', data: "reason" }
                        ],
                        pageLength: 10
                    });
                }
                $("#contenedorProducto").show();
            });
        }

        $(document).ready(function () {
            $("#selectProducto").select2({ language: "es", width: "100%" }).on("change", function () {
                cargarProducto($(this).val());
            });

            $("#formMovimiento").submit(function (e) {
                e.preventDefault();
                $.ajax({
                    url: $(this).attr("action"),
                    data: $(this).serialize(),
                    dataType: 'json',
                    type: 'POST',
                    beforeSend: function () {
                        showLoader();
                    },
                    success: function (data) {
                        hideLoader();
                        if (data.tipo === "s") {
                            swal("¡Bien!", data.mensaje, "/images/menu/success.png");
                            $("#Quantity").val("");
                            $("#Reason").val("");
                            cargarProducto($("#productoId").val());
                        } else {
                            swal("¡Advertencia!", data.mensaje, "/images/menu/error.png");
                        }
                    },
                    error: function () {
                        hideLoader();
                        swal("¡Advertencia!", "No se pudo registrar el movimiento.", "/images/menu/error.png");
                    }
                });
            });

            hideLoader();

            var productoInicial = '@(ViewBag.ProductoId)';
            if (productoInicial)
                cargarProducto(productoInicial);
        });
    </script>
}
