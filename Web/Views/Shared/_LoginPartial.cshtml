@using InventoryManagement.Web.Services
@inject SignInManager<InventoryManagement.Models.Identidad.Usuario> SignInManager
@inject UserManager<InventoryManagement.Models.Identidad.Usuario> UserManager
@inject EmpresasUsuario EmpresasUsuario

@{
    var empresa = Context.Session.GetObjectFromJson<InventoryManagement.Web.Models.Session.EmpresaViewModel>("Empresa");
    var modulos = EmpresasUsuario.NombresModulos;
    var listaModulos = new List<string>();
    var usuarioLogueado = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var nombreUsuario = !string.IsNullOrWhiteSpace(usuarioLogueado?.Name) ? usuarioLogueado.Name : User.Identity?.Name;
    var cantidadEmpresas = 0;
    if (empresa != null)
    {
        listaModulos = InventoryManagement.Models.Utilitarios.Areas.ObtenerModulos().Where(m => empresa.Modulos.Contains(m.Value)).OrderBy(m => m.Key).Select(m => m.Value).ToList();
        cantidadEmpresas = (await EmpresasUsuario.GetForUserAsync(User.GetUserId<int>())).Count;
    }
}

<style>
    .navbar-nav > li > a > svg {
        line-height: 40px;
        display: inline-block;
        width: 1.2rem;
        height: 1.2rem;
        margin-right: 20px;
        text-align: center;
        vertical-align: middle;
        border-radius: 12%;
        background: #fff;
        -webkit-box-shadow: 0 0 10px rgba(0, 0, 0, .12);
        box-shadow: 0 0 10px rgba(0, 0, 0, .12);
        padding: 0.7rem;
    }

    .navbar-nav li > a {
        color: #1a4c52;
        position: relative;
        display: table;
        border-collapse: collapse;
        border-spacing: 0;
        font-family: arial;
        font-size: 14px;
        text-decoration: none;
        -webkit-transform: translateZ(0) scale(1,1);
        -webkit-transition: all .1s linear;
        transition: all .1s linear;
    }

    .sesion-navbar {
        display: inline-flex;
        align-items: center;
        vertical-align: middle;
        margin-right: .6rem;
        color: #1a4c52;
        text-align: left;
    }

    .sesion-navbar .sesion-icono {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        margin-right: .6rem;
        border-radius: 50%;
        background: rgba(26, 76, 82, .1);
        color: #1a4c52;
        font-size: 15px;
    }

    .sesion-navbar .sesion-textos {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
        min-width: 0;
    }

    .sesion-navbar .sesion-empresa,
    .sesion-navbar .sesion-usuario {
        max-width: 18rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sesion-navbar .sesion-empresa {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .2px;
        text-transform: uppercase;
    }

    .sesion-navbar .sesion-usuario {
        font-size: 11.5px;
        font-weight: 400;
        opacity: .85;
    }

    /* La barra superior es verde petróleo: en ella el bloque va en blanco */
    #navbarDropdownUsuario .sesion-navbar {
        color: #fff;
        padding-right: .75rem;
        border-right: 1px solid rgba(255, 255, 255, .25);
    }

    #navbarDropdownUsuario .sesion-navbar .sesion-icono {
        background: rgba(255, 255, 255, .15);
        border: 1px solid rgba(255, 255, 255, .35);
        color: #fff;
    }

    .sesion-dropdown-cabecera {
        padding: .5rem 1.5rem .6rem;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: .25rem;
        line-height: 1.3;
    }

    .sesion-dropdown-cabecera .titulo {
        font-size: 13px;
        font-weight: 700;
        color: #1a4c52;
    }

    .sesion-dropdown-cabecera .detalle {
        font-size: 11.5px;
        color: #6c757d;
    }
</style>

@if (SignInManager.IsSignedIn(User) && empresa != null)
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" id="logoutForm"></form>
    <ul class="navbar-nav my-2 my-lg-0" id="ulCelular">
        <li class="liEscondido menu-item nav-item dropdown pb-2">
            <a class="" href="@Url.Content("~/Configuracion/Resumen/Inicio")">
                <img width="170" src="/images/LetraContagestor.png" />
            </a>
        </li>
        <li class="liEscondido nav-item dropdown">
            <span class="dropdown-item sesion-navbar">
                <span class="sesion-icono"><i class="fas fa-building"></i></span>
                <span class="sesion-textos">
                    <span class="sesion-empresa">@empresa.Nombre</span>
                    <span class="sesion-usuario"><i class="fas fa-user mr-1"></i>@nombreUsuario</span>
                </span>
            </span>
            @if (cantidadEmpresas > 1)
            {
                <a class="dropdown-item" asp-area="" asp-controller="Principal" asp-action="CambiarEmpresa">Cambiar empresa</a>
            }
            <a style="color:#dc6b29;" class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit();">Salir del sistema</a>
            <hr />
        </li>
        <li class="liEscondidoInverso nav-item dropdown">
            <a class="nav-link text-lg-right" href="#" id="navbarDropdownUsuario" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="@empresa.Nombre - @nombreUsuario">
                <span class="sesion-navbar">
                    <span class="sesion-icono"><i class="fas fa-building"></i></span>
                    <span class="sesion-textos">
                        <span class="sesion-empresa">@empresa.Nombre</span>
                        <span class="sesion-usuario"><i class="fas fa-user mr-1"></i>@nombreUsuario</span>
                    </span>
                </span>
                <i style="margin-right:0px; padding: 0px; background: transparent; color: white;" class="fas fa-caret-down"></i><img width="35" src="~/images/menu/menu.png" />
            </a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdownUsuario">
                <div class="sesion-dropdown-cabecera">
                    <div class="titulo">@empresa.Nombre</div>
                    <div class="detalle">RUC: @empresa.Identificacion</div>
                    <div class="detalle"><i class="fas fa-user mr-1"></i>@nombreUsuario</div>
                </div>
                @if (cantidadEmpresas > 1)
                {
                    <a class="dropdown-item" asp-area="" asp-controller="Principal" asp-action="CambiarEmpresa">Cambiar empresa</a>
                }
                <a style="color:#dc6b29;" class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit();">Salir del sistema</a>
            </div>
        </li>

        <li class="liEscondido menu-item nav-item dropdown pb-2">
            <a class="" href="@Url.Content("~/Configuracion/Resumen/Inicio")">
                <i class="fas fa-chart-line"></i>
                <span class="nav-text">
                    Panel inicial
                </span>
            </a>
        </li>
        @foreach (var item in listaModulos)
        {
            if (empresa.Pantallas.Any(m => m.Modulo == item && m.Activo))
            {
                <li class="liEscondido menu-item nav-item dropdown pb-2">
                    <a style="color: #1a4c52 !important;" class="nav-link" href="@($"#{item}Submenu")" data-toggle="collapse" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-@(modulos[item][1])" style="font-size: 0.75em !important;"></i>
                        <span class="nav-text">
                            @modulos[item][0]
                        </span>
                    </a>
                    <ul class="sub-menu collapse" id="@($"{item}Submenu")">
                        @foreach (var pantalla in empresa.Pantallas.Where(m => m.Modulo == item && m.Activo))
                        {
                            <li class="dropdown-item">
                                <a asp-area="@pantalla.Area" asp-controller="@pantalla.Controlador" asp-action="@(pantalla.Accion ?? "Inicio")">
                                    <span class="text">@pantalla.Nombre</span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>
}
else
{
    <ul class="navbar-nav my-2 my-lg-0">
        <li class="nav-item"><a asp-area="Identity" asp-page="/Account/Login" class="nav-link">Entrar</a></li>
    </ul>
}
