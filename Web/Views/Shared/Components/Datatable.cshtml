<style>
    td.details-control {
        background: url('../images/datatables.net/details_open.png') no-repeat center center;
        min-width: 32px;
        cursor: pointer;
    }

    tr.shown td.details-control {
        background: url('../images/datatables.net/details_close.png') no-repeat center center;
        min-width: 32px;
        cursor: pointer;
    }

    .d-flex .bd-highlight {
        padding-bottom: 5px;
    }

    table.dataTable, .dataTables_wrapper {
        font-size: 13px;
    }

    .dataTables_info, .pagination > .paginate_button {
        font-size: 11.5px;
    }

    .table > tbody > tr > td {
        padding: 0.25rem;
        vertical-align: middle;
    }

    .table thead th {
        vertical-align: middle;
    }

    button.acciones > i.fas, btn acciones > i.fa {
        font-size: 12.5px;
    }

    a.acciones {
        width: 29px;
        height: 29px;
        padding: 0.10rem 0.10rem !important;
    }

    button.acciones {
        width: 29px;
        height: 29px;
        padding: 0.10rem 0.10rem !important;
    }

    a.acciones > i.fas, btn acciones > i.fa {
        font-size: 12.5px;
    }

    tr.thead-filter > th > input, tr.thead-filter > th > select {
        height: 22.5px !important;
    }

    a.acciones-dropdown {
        height: 29px;
        padding: 0.10rem 0.10rem !important;
    }

    a.acciones-dropdown > i.fas, btn acciones-dropdown > i.fa {
        font-size: 12.5px;
    }

    .table-sm td {
        padding: 0.1rem !important;
        vertical-align: middle;
    }

    .detail-title {
        font-size: 0.875rem;
    }

    .dataTables_filter {
        padding-top: 5.5px;
    }

    .dataTables_filter > label {
        margin-bottom: 5px;
        width: 100%;
    }

    table.dataTable, .dataTables_wrapper {
        margin-top: 0 !important;
    }

    table thead tr.thead-filter > th, table thead tr.thead-filter > td {
        padding: 0 !important;
    }

    .table-details {
        font-size: 0.75rem;
    }

    /*Resumen Asignacion*/
    .tbody-resumen > tr > td {
        font-size: 0.75rem;
    }

    .tbody-resumen > tr > td > input {
        font-size: 0.775rem !important;
    }

    /*Responsive*/
    .scrolledTable {
        overflow-y: auto;
        clear: both;
    }
</style>

