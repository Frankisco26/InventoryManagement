<environment include="Development">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.3/toastr.css"
          asp-fallback-href="~/lib/toastr/toastr.css"
          integrity="sha256-He3QEBKoL/nMXlVsoM7S2C2kjFQqS5L+mgA+F8LpG+U="
          crossorigin="anonymous" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.3/toastr.min.js" integrity="sha512-lbwH47l/tPXJYG9AcFNoJaTMhGvYWhVM9YI43CT+uteTRRaiLCui8snIgyAN8XWgNjNhCqlAUdzZptso6OCoFQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</environment>
<environment exclude="Development">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.3/toastr.min.css"
          asp-fallback-href="~/lib/toastr/toastr.min.css"
          integrity="sha256-R91pD48xW+oHbpJYGn5xR0Q7tMhH4xOrWn1QqMRINtA="
          crossorigin="anonymous" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.3/toastr.min.js" 
            integrity="sha256-yNbKY1y6h2rbVcQtf0b8lq4a+xpktyFc3pSYoGAY1qQ=" 
            asp-fallback-href="~/lib/toastr/toastr.min.js"
            crossorigin="anonymous"></script>
</environment>

<script>
    function showToast(icon, mensaje) {
        var tipo, titulo;
        switch (icon) {
                case "s": tipo = "success";
                    titulo = "Operación Exitosa";
                    break;
                case "e": tipo = "error";
                    titulo = "Error!";
                    break;
                case "w": tipo = "warning";
                    titulo = "Advertencia!";
                    break;
                case "i": tipo = "info";
                    titulo = "Información";
                    break;
                default:
            }
        if (mensaje !== "") {
            toastr.options = {
                    "closeButton": true,
                    "debug": false,
                    "newestOnTop": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "preventDuplicates": false,
                    "onclick": null,
                    "showDuration": "300",
                    "hideDuration": "1000",
                    "timeOut": "2000",
                    "extendedTimeOut": "1000",
                    "showEasing": "swing",
                    "hideEasing": "linear",
                    "showMethod": "fadeIn",
                    "hideMethod": "fadeOut"
                };
            toastr[tipo](mensaje, titulo);
        }
    }
    $(document).ready(function () {
        showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["tipo"]?.ToString() ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["mensaje"]?.ToString() ?? "")));
    });
</script>
