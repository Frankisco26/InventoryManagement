@page "/products"
@attribute [Authorize]
@namespace InventoryManagement.Web.Components.Pages.Products
@rendermode InteractiveServer
@using InventoryManagement.Data.Dtos
@using InventoryManagement.Web.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Productos</h2>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-success" @onclick='() => NavigationManager.NavigateTo("/products/new")'>
                <span class="oi oi-plus"></span> Nuevo Producto
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            Cargando productos...
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    else if (products == null || !products.Any())
    {
        <div class="alert alert-warning">
            No hay productos. <a href="/products/new">Crea uno ahora</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>SKU</th>
                                <th>Categoría</th>
                                <th>Stock</th>
                                <th>Stock Mínimo</th>
                                <th>Precio</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in products)
                            {
                                <tr class='@((product.QuantityInStock <= product.MinimumStock) ? " table-danger" : "")'>
                                    <td>
                                        @product.Name
                                    </td>
                                    <td>
                                        <strong>@product.SKU</strong>
                                    </td>
                                    <td>
                                        @product.Category
                                    </td>
                                    <td>
                                        @product.QuantityInStock
                                    </td>
                                    <td>
                                        @product.MinimumStock
                                    </td>
                                    <td>
                                        $@product.UnitPrice.ToString("F2")
                                    </td>
                                    <td>

                                        <button class="btn btn-sm btn-info" @onclick="() => ViewProduct(product.Id)">
                                            <span class="oi oi-eye"></span> Ver
                                        </button>
                                        <button class="btn btn-sm btn-primary" @onclick="() => EditProduct(product.Id)">
                                            <span class="oi oi-pencil"></span> Editar
                                        </button>
                                        <button class="btn btn-sm btn-warning" @onclick='() => NavigationManager.NavigateTo($"/products/{product.Id}/movement")'>
                                            <span class="oi oi-arrow-right"></span> Movimiento
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product.Id)">
                                            <span class="oi oi-trash"></span> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
